# Modelo do .env usado na VM (o .env real tem os segredos e não vai para o git).

# URL pública da API, SEM barra no final. O caminho /evolution é obrigatório.
SERVER_URL=https://exodosystems.tail9b4943.ts.net/evolution

# Banco (interno do compose, não publicado no host)
POSTGRES_DB=evolution
POSTGRES_USER=evolution
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Chave global: o app Flutter envia no header `apikey`.
AUTHENTICATION_API_KEY=troque-por-uma-chave-longa-e-aleatoria

# Manter `*`: o app mobile não envia header Origin e seria bloqueado.
# Ver a seção "CORS" do README.
CORS_ORIGIN=*

LANGUAGE=pt-BR
LOG_LEVEL=ERROR,WARN,INFO,WEBHOOKS

# --- Bot de atendimento (servico `bot` do compose / container evo_bot) ---
# O Ollama roda na maquina Windows. No NAT do VirtualBox, 10.0.2.2 e o
# loopback do host, entao nada precisa ser exposto na rede local.
# --- Identidade da EMPRESA (o mesmo codigo do bot atende qualquer loja) ---
# Nome que aparece nas respostas. Use {empresa} nas frases abaixo para reaproveitar.
BOT_EMPRESA_NOME=E o Bicho Pet Shop

# Prompt do atendente. Tres formas, nesta ordem de prioridade:
# 1) BOT_PROMPT_FILE=/config/prompt.txt  -> arquivo, editavel sem reiniciar
# 2) BOT_PROMPT=<texto>                  -> aqui no .env (use \n para quebrar linha)
# 3) vazio                               -> prompt padrao generico do bot
# Em qualquer uma, {empresa} e trocado por BOT_EMPRESA_NOME.
BOT_PROMPT_FILE=
BOT_PROMPT=

# Dados basicos da loja (horario, endereco, pagamento, servicos, entrega).
# Sao respondidos SEM passar pela IA, entao nao ha como alucinar. O arquivo
# fica montado pelo compose em ./bot/negocio.json e e relido a cada mensagem.
BOT_CONFIG_FILE=/config/negocio.json

BOT_OLLAMA_URL=http://10.0.2.2:11434
# Modelo neutro (sem prompt embutido). Use o mesmo para todas as empresas.
BOT_MODEL=eobicho
BOT_INSTANCE=e-o-bicho-petshop
# Segundos de espera para agrupar mensagens seguidas do mesmo cliente.
BOT_DEBOUNCE=3
# Teto de respostas por contato por hora (protecao contra loop/abuso).
BOT_MAX_REPLIES_HOUR=20

# Pausa o bot para um contato depois que a loja responde pelo celular (minutos).
BOT_HUMAN_MUTE_MIN=30
# Pausa maior quando o cliente pede para falar com uma pessoa.
BOT_HANDOFF_MUTE_MIN=120

# Janela em que o bot PODE responder. Vazio = 24h.
# Exemplos: 18:00-08:00 (so fora do horario) ou 00:00-23:59 (o dia todo).
BOT_ACTIVE_HOURS=

# Opcional: so responde se a mensagem contiver uma destas palavras
# (separadas por virgula). Vazio = responde todas.
BOT_KEYWORDS=

# Numeros que o bot NUNCA responde (separados por virgula, com DDD).
# Use para grupos internos, fornecedores, testes ou qualquer contato que nao
# deve receber mensagem do atendente virtual. Aceita com ou sem o 55.
# Ex.: BOT_IGNORAR_NUMEROS=11999999999,11888888888
BOT_IGNORAR_NUMEROS=

# Frase enviada na primeira resposta de cada contato dentro de 12h.
# Deixe vazio para nao avisar que e um assistente virtual (nao recomendado).
BOT_INTRO=Oi! Sou o assistente virtual da loja. Ja chamei a equipe para falar com voce.

# Dados oficiais da loja: e o UNICO lugar de onde o bot pode tirar horario,
# endereco, formas de pagamento e servicos. Escreva em frases curtas, uma por linha.
# Enquanto estiver vazio, qualquer resposta que afirme algo factual e trocada
# pela mensagem abaixo.
# BOT_EXTRA_INFO=Horario: seg a sex 8h as 18h; sabado 8h as 12h.
# BOT_EXTRA_INFO=Endereco: Rua X, 123 - Centro.
BOT_EXTRA_INFO=

# O que o cliente recebe quando o bot nao pode afirmar o dado.
BOT_FALLBACK=Vou confirmar essa informação com a equipe e já te respondo por aqui.

# Onde o bot grava as pausas por contato (volume `bot_state` do compose).
# Nao aponte para dentro do container sem volume, senao a pausa se perde no restart.
BOT_STATE_FILE=/data/state.json

# Token das rotas de administracao usadas pelo app (conversar com o bot e pausar).
# Sem ele, qualquer programa que alcance a porta 8097 do host controla o bot.
# Gere com: head -c 24 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 24
BOT_ADMIN_TOKEN=

# --- escopo do nicho: o que o bot pode falar ---
# Assuntos, bloqueios (o que a loja nao faz) e a frase de fora do tema ficam em
# negocio.json -> "foco". Aqui so o liga/desliga do modelo:
#   0 = mensagem dentro do nicho pode usar a IA (padrao)
#   1 = sem IA: o bot so responde o que estiver no negocio.json
BOT_STRICT=0

# --- consulta de pedidos (somente leitura) ---
# DSN do banco da loja. Vazio = o bot nao consulta e so responde "vou confirmar com
# a equipe". Formato: postgresql://usuario:senha@host:porta/banco
BOT_PEDIDOS_DSN=
# Quantos pedidos listar e quanto esperar o banco responder.
BOT_PEDIDOS_MAX=2
BOT_PEDIDOS_TIMEOUT=6
# Frase para pergunta fora dos assuntos do nicho ({assuntos} vira a lista do foco).
# BOT_FORA_TEMA=Por aqui eu ajudo com {assuntos}. Sobre isso, a equipe te responde.
