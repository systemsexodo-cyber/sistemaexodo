# ============================================
# Configurações de Produção - Backend NFC-e
# ============================================
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.production
# 2. Configure todas as variáveis abaixo
# 3. Gere uma SECRET_KEY forte (o script configurar_producao.bat faz isso automaticamente)
#
# ============================================

# ============================================
# SEGURANÇA
# ============================================
# IMPORTANTE: Gere uma chave secreta forte!
# Execute: python -c "import secrets; print(secrets.token_hex(32))"
# Ou deixe o script configurar_producao.bat gerar automaticamente
SECRET_KEY=GERE-UMA-CHAVE-SECRETA-FORTE-AQUI

# Modo de debug (sempre False em produção)
DEBUG=False

# ============================================
# SERVIDOR
# ============================================
# Host do servidor (0.0.0.0 para aceitar conexões de qualquer IP)
HOST=0.0.0.0

# Porta do servidor (5000 padrão, Cloud Run usa PORT do ambiente)
PORT=5000

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Origens permitidas (separadas por vírgula)
# Em produção real, especifique os domínios exatos:
# CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com
# Para desenvolvimento, use * (não recomendado em produção)
CORS_ORIGINS=*

# ============================================
# LOGGING
# ============================================
# Nível de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Arquivo de log
LOG_FILE=logs/production.log

# ============================================
# WAITRESS (Servidor WSGI)
# ============================================
# Número de threads do Waitress
WAITRESS_THREADS=8

# Timeout do canal (em segundos)
WAITRESS_CHANNEL_TIMEOUT=120

# ============================================
# LIMITES
# ============================================
# Tamanho máximo de upload (em bytes)
# Padrão: 10MB (10485760 bytes)
MAX_CONTENT_LENGTH=10485760

# ============================================
# NOTAS
# ============================================
# - Este arquivo NÃO deve ser commitado no Git
# - Mantenha o .env.production.example atualizado
# - Em produção real, use variáveis de ambiente do sistema ou secrets manager
# - Para Cloud Run, configure as variáveis no console do Google Cloud
