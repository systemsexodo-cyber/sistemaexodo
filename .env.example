[TEMPLATE]
# ============================================================================
# CONFIGURAÇÃO DO BANCO DE DADOS - POSTGRESQL
# ============================================================================
#
# Este arquivo contém as variáveis de ambiente para conexão com PostgreSQL
#
# IMPORTANTE:
# 1. Mantenha este arquivo como template (.env.example)
# 2. O instalador gera o .env automaticamente com as configurações corretas
# 3. NUNCA versione o .env real em Git
#
# ============================================================================
# POSTGRESQL - CONEXÃO BÁSICA
# ============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=exodo_db
DB_USER=exodo_user
DB_PASSWORD=ex@#$

# ============================================================================
# REDE LOCAL (sincronização entre os PCs da MESMA loja)
# ============================================================================
#
# Faz os dois bancos locais conversarem DIRETO pela rede local, sem passar pela
# nuvem. Serve para a internet cair e as duas máquinas continuarem atualizadas.
# A nuvem continua sendo o caminho principal: a LAN é um atalho a mais.
#
# NÃO PRECISA PREENCHER À MÃO: no app, tela inicial -> botão "Rede LAN", dá para
# procurar o outro PC na rede, liberar este PC (o Windows pede Administrador) e
# salvar tudo por lá. Estas chaves existem para o caso de querer ajustar na mão.
#
# Configure APENAS o PAR_HOST (o NOME do OUTRO computador). Deixe vazio para
# desligar a LAN — o sincronizador da nuvem continua funcionando como sempre.
#
# USE O NOME, NÃO O IP: o IP da loja vem do roteador (DHCP) e muda sozinho de
# tempos em tempos, derrubando a LAN sem ninguém mexer. O nome do computador
# acompanha a máquina. O IP ainda funciona, mas não é recomendado.
# O nome exato aparece no outro PC em: Configurações > Sistema > Sobre.
#
# O PostgreSQL do outro PC precisa aceitar conexão da rede local. Rode uma vez,
# em cada máquina, como Administrador (sem informar IP: libera a rede toda):
#     powershell -ExecutionPolicy Bypass -File scripts\configurar_lan_postgres.ps1
#
# Exemplo: no PC-CAIXA-1 você põe PAR_HOST=PC-CAIXA-2; no PC-CAIXA-2 você põe
# PAR_HOST=PC-CAIXA-1.

PAR_HOST=
PAR_PORT=5432
# PAR_DB_NAME / PAR_DB_USER / PAR_DB_PASSWORD não são obrigatórios quando os dois
# PCs usam o mesmo banco e as mesmas credenciais (o padrão é herdar DB_*).
PAR_DB_NAME=
PAR_DB_USER=
PAR_DB_PASSWORD=
# Rótulo do par (aparece no log e no cursor). Padrão: o próprio PAR_HOST.
PAR_NOME=
# LAN_SYNC=false desliga sem precisar apagar o PAR_HOST.
LAN_SYNC=true
# Retenção dos apagados (_exodo_deletados). Um PC desligado por mais tempo que
# isto perderá os apagados do período.
LAN_DIAS_TOMBSTONE=30
# true = no primeiro contato puxa o HISTÓRICO INTEIRO do outro PC. Padrão false:
# começa de agora (o histórico já é alinhado pela nuvem).
LAN_INICIAL_COMPLETO=false
# De quanto em quanto tempo (segundos) o loop da LAN procura mudanças no outro
# PC. É o que faz a mudança do outro PC aparecer rápido, sem depender da nuvem.
# Padrão 2; mínimo 1.
LAN_INTERVALO=2

# ============================================================================
# SQLALCHEMY (Para aplicações Flask com SQLAlchemy)
# ============================================================================

# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://exodo_user:ex@#$@localhost:5432/exodo_db

# Pool de conexões
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600

# ============================================================================
# SUPABASE - NUVEM
# ============================================================================

SUPABASE_URL=https://febffvlpvxtiihvnfuts.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZlYmZmdmxwdnh0aWlodm5mdXRzIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NjA1MjA3NSwiZXhwIjoyMDkxNjI4MDc1fQ.r7-IAXHz7hAEjmYIM4pO9uqIaFYwaOZQucKw6DoblhE

# ============================================================================
# SUPABASE - BANCO DA NUVEM (usado pelo backup do banco inteiro)
# ============================================================================
#
# A conexão DIRETA (db.<ref>.supabase.co) só responde em IPv6, por isso o
# backup usa o "Session pooler" (IPv4). A senha é a do BANCO (painel do
# Supabase -> Project Settings -> Database -> Database password) — as chaves de
# API "sb_secret_..." NÃO servem como senha.

SUPABASE_POOLER_HOST=aws-1-us-west-2.pooler.supabase.com
SUPABASE_POOLER_PORT=5432
SUPABASE_POOLER_PASSWORD=

# ============================================================================
# BACKUP AUTOMÁTICO DO BANCO DA NUVEM
# ============================================================================
#
# De quantas em quantas horas o app gera uma cópia COMPLETA do banco da nuvem
# (todas as empresas) e a arquiva na própria nuvem, em dumps/_banco_completo/.
# Padrão: 24. Use 168 para semanal, ou 0 para desligar (o botão na tela continua
# funcionando). São mantidos os 10 arquivos mais recentes.

BACKUP_COMPLETO_NUVEM_HORAS=24

# ============================================================================
# LOGS
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Retenção do sincronizador.log (o log do SincronizadorNuvem/tray):
#   LOG_RETENCAO_DIAS          quantos dias de log são mantidos (padrão 7)
#   LOG_TAMANHO_MAX_MB         teto de tamanho do arquivo (padrão 10)
#   LOG_REPETIDO_SEGUNDOS      agrupa mensagem idêntica repetida nesse intervalo
#                              (padrão 60; 0 desliga o agrupamento)
#   LOG_PODA_INTERVALO_MINUTOS de quanto em quanto tempo o log é podado (padrão 10)
#   LOG_ARQUIVO                caminho alternativo do log (opcional; útil para podar
#                              o log de uma instalação, ex.: C:\SistemaExodo\sincronizador.log)
# A poda também roda ao abrir o sincronizador e no item "Limpar Logs Antigos (7 dias)".
LOG_RETENCAO_DIAS=7
LOG_TAMANHO_MAX_MB=10
LOG_REPETIDO_SEGUNDOS=60
LOG_PODA_INTERVALO_MINUTOS=10
