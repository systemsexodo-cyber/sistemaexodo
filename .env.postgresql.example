# ============================================================================
# CONFIGURAÇÃO DO BANCO DE DADOS - POSTGRESQL
# ============================================================================
# 
# Este arquivo contém as variáveis de ambiente para conexão com PostgreSQL
# 
# IMPORTANTE:
# 1. Renomeie para .env (remova o .example)
# 2. Altere os valores para sua configuração
# 3. NUNCA versione este arquivo em Git (adicione ao .gitignore)
# 4. Certifique-se de que PostgreSQL está rodando
#

# ============================================================================
# POSTGRESQL - CONEXÃO BÁSICA
# ============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=exodo_db
DB_USER=exodo_user
DB_PASSWORD=sua_senha_super_segura_aqui

# ============================================================================
# SQLALCHEMY (Para aplicações Flask com SQLAlchemy)
# ============================================================================

# Formato: postgresql://usuario:senha@host:porta/banco
DATABASE_URL=postgresql://exodo_user:sua_senha_super_segura_aqui@localhost:5432/exodo_db

# Pool de conexões
SQLALCHEMY_ECHO=false
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600

# ============================================================================
# FLASK
# ============================================================================

FLASK_ENV=development
FLASK_DEBUG=false
SECRET_KEY=sua_chave_secreta_aqui

# ============================================================================
# CORS
# ============================================================================

CORS_ORIGINS=*

# ============================================================================
# FIREBASE (Se ainda usar Firebase em paralelo)
# ============================================================================

FIREBASE_PROJECT_ID=seu-projeto-id
FIREBASE_PRIVATE_KEY_ID=sua-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=seu-email@seu-projeto.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=seu-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=sua-cert-url

# ============================================================================
# UPLOADS E LIMITES
# ============================================================================

MAX_CONTENT_LENGTH=10485760  # 10MB em bytes
UPLOAD_FOLDER=./uploads

# ============================================================================
# LOGS
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============================================================================
# NOTAS IMPORTANTES
# ============================================================================
#
# 1. SENHA SEGURA:
#    - Mínimo 12 caracteres
#    - Misture letras, números e símbolos
#    - Exemplo: P@ssw0rd!2024
#
# 2. AMBIENTE DE DESENVOLVIMENTO vs PRODUÇÃO:
#    - Dev: FLASK_DEBUG=true, DB local
#    - Prod: FLASK_DEBUG=false, DB em servidor
#
# 3. BACKUP DESTA CONFIGURAÇÃO:
#    - Guarde em local seguro
#    - Não compartilhe no GitHub
#    - Adicione .env ao .gitignore
#
# 4. MUDANÇAS:
#    - Após alterar, reinicie a aplicação
#    - Verifique com: python test_postgres_connection.py
#
