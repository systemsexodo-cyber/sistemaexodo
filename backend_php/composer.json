{
    "name": "sistema-exodo/backend-nfce",
    "description": "Backend PHP para emissão de NFC-e usando SPED-NFe",
    "type": "project",
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2|^8.3",
        "nfephp-org/sped-nfe": "^5.0",
        "monolog/monolog": "^2.0|^3.0",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "SistemaExodo\\BackendNfce\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}











